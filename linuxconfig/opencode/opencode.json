{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-gemini-auth@latest"
    ],
    "autoupdate": true,
    "mcp": {
        "pdf-reader": {
            "type": "local",
            "command": [
                "bun",
                "x",
                "@sylphx/pdf-reader-mcp"
            ],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "bun",
                "x",
                "@playwright/mcp@latest",
                "--browser",
                "firefox"
            ],
            "enabled": true
        }
    }
}
