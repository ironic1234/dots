# Taskwarrior config for life infrastructure
# Keep task data in the synced life directory.

data.location=~/.local/share/life/task
news.version=0
confirmation=1
verbose=blank,label,new-id,affected,edit,special,project,sync,unwait,wait

# Useful defaults for daily work
report.next.columns=id,start.age,entry.age,priority,project,tags,recur,description,urgency
report.next.labels=ID,Active,Age,P,Project,Tags,R,Description,Urg

# Optional user-defined attributes
uda.area.type=string
uda.area.label=Area
