#!/usr/bin/env python3
"""Build a lightweight JSONL index for markdown notes."""

from __future__ import annotations

import argparse
import json
import os
import re
from pathlib import Path
from typing import Iterable

HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*$", re.MULTILINE)
TAG_RE = re.compile(r"(?<!\w)#([a-zA-Z][\w\-/]+)")
WORD_RE = re.compile(r"\b\w+\b")


def first_heading(text: str, fallback: str) -> str:
    match = HEADING_RE.search(text)
    return match.group(2).strip() if match else fallback


def extract_headings(text: str) -> list[str]:
    return [m.group(2).strip() for m in HEADING_RE.finditer(text)]


def extract_tags(text: str) -> list[str]:
    return sorted(set(m.group(1).lower() for m in TAG_RE.finditer(text)))


def iter_notes(notes_dir: Path) -> Iterable[Path]:
    for path in sorted(notes_dir.rglob("*.md")):
        if ".index" in path.parts:
            continue
        yield path


def build_index(notes_dir: Path, out_file: Path) -> int:
    out_file.parent.mkdir(parents=True, exist_ok=True)
    count = 0

    with out_file.open("w", encoding="utf-8") as handle:
        for note in iter_notes(notes_dir):
            text = note.read_text(encoding="utf-8", errors="ignore")
            rel = note.relative_to(notes_dir).as_posix()
            entry = {
                "path": rel,
                "title": first_heading(text, note.stem),
                "headings": extract_headings(text),
                "tags": extract_tags(text),
                "word_count": len(WORD_RE.findall(text)),
                "updated_at": note.stat().st_mtime,
            }
            handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
            count += 1

    return count


def parse_args() -> argparse.Namespace:
    default_notes_dir = Path(os.environ.get("NOTES_HOME", str(Path.home() / "notes")))

    parser = argparse.ArgumentParser(description="Index markdown notes for LLM retrieval")
    parser.add_argument(
        "--notes-dir",
        type=Path,
        default=default_notes_dir,
        help="Notes directory (default: $NOTES_HOME or ~/notes)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=None,
        help="Output JSONL file (default: <notes-dir>/.index/notes-index.jsonl)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    notes_dir: Path = args.notes_dir
    output: Path = args.output or (notes_dir / ".index" / "notes-index.jsonl")

    notes_dir.mkdir(parents=True, exist_ok=True)
    count = build_index(notes_dir, output)
    print(f"Indexed {count} notes -> {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
