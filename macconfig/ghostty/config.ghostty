# === Theme (Catppuccin Mocha) ===
theme = Catppuccin Mocha

# === Window padding ===
window-padding-x = 10
window-padding-y = 10

background-opacity = 0.8
background-blur = true

# === Fonts ===
font-family = "Hack Nerd Font Mono"
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"
