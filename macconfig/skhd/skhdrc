# ── Layout ───────────────────────────────────────────────
alt - e : yabai -m space --layout bsp;
alt - s : yabai -m space --layout stack;

# ── Focus ────────────────────────────────────────────────
# Directional focus
alt - down : yabai -m window --focus south;
alt - up : yabai -m window --focus north;
alt - right : yabai -m window --focus east;
alt - left : yabai -m window --focus west;

# Horizontal focus aliases
alt - p : yabai -m window --focus east;
alt - o : yabai -m window --focus west;

# ── Window Manipulation ──────────────────────────────────
# Move windows
shift + alt - down : yabai -m window --swap south;
shift + alt - up : yabai -m window --swap north;
shift + alt - right : yabai -m window --swap east;
shift + alt - left : yabai -m window --swap west;

# Window actions
alt - f : yabai -m window --toggle zoom-fullscreen;
alt - x : yabai -m window --close;

# ── Displays ─────────────────────────────────────────────
# Move the focused window and follow it
ctrl + alt - right : yabai -m window --display 1; yabai -m display --focus 1;
ctrl + alt - left : yabai -m window --display 2; yabai -m display --focus 2;

# Focus a display without moving the window
alt - l : yabai -m display --focus 1;
alt - j : yabai -m display --focus 2;

# ── Workspaces ───────────────────────────────────────────
# Move the focused window and follow it
shift + alt - 1 : yabai -m window --space 1 && yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2 && yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3 && yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4 && yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5 && yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6 && yabai -m space --focus 6
shift + alt - 7 : yabai -m window --space 7 && yabai -m space --focus 7
shift + alt - 8 : yabai -m window --space 8 && yabai -m space --focus 8
shift + alt - 9 : yabai -m window --space 9 && yabai -m space --focus 9
shift + alt - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# Focus a workspace without moving the window
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# ── Applications ─────────────────────────────────────────
alt - k : open -na Ghostty --args --working-directory="$HOME"
alt - t : open "/Applications/Firefox Nightly.app"

# ── System ───────────────────────────────────────────────
alt - w : skhd --key "cmd - w";
alt - q : skhd --key "cmd - q";
