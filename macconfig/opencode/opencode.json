{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "builder",
    "instructions": [
        "./instructions/task-completion-and-testing.md",
        "./instructions/planning-first-execution.md"
    ],
    "permission": {
        "bash": {
            "*": "allow",
            "gh *": "deny"
        }
    },
    "agent": {
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "builder": {
            "description": "Primary implementation agent with mandatory planning before edits",
            "mode": "primary",
            "temperature": 0.2,
            "prompt": "{file:./prompts/build-plan-first.md}",
            "permission": {
                "bash": {
                    "*": "allow"
                },
                "task": {
                    "*": "deny"
                }
            }
        },
        "planner": {
            "description": "Read-only planning agent for architecture, sequencing, and risk analysis",
            "mode": "all",
            "temperature": 0.1,
            "prompt": "{file:./prompts/planner-readonly.md}",
            "permission": {
                "edit": "deny",
                "bash": "deny",
                "task": {
                    "*": "deny"
                }
            }
        },
        "orchestrator": {
            "description": "Manager agent that decomposes work and delegates execution to specialists",
            "mode": "all",
            "temperature": 0.2,
            "prompt": "{file:./prompts/orchestrator-manager.md}",
            "permission": {
                "edit": "deny",
                "bash": "deny",
                "webfetch": "deny",
                "task": {
                    "*": "deny",
                    "planner": "allow",
                    "executor": "allow",
                    "test-runner": "allow",
                    "explore": "allow",
                    "docs-researcher": "allow",
                    "github": "allow"
                }
            }
        },
        "executor": {
            "description": "General execution agent for implementation, refactoring, and bug fixing",
            "mode": "all",
            "temperature": 0.2,
            "prompt": "{file:./prompts/executor-general.md}",
            "permission": {
                "bash": {
                    "*": "allow",
                    "npm test*": "deny",
                    "pnpm test*": "deny",
                    "yarn test*": "deny",
                    "bun test*": "deny",
                    "pytest*": "deny",
                    "go test*": "deny",
                    "cargo test*": "deny"
                },
                "task": {
                    "*": "deny"
                }
            }
        },
        "github": {
            "description": "GitHub specialist that uses gh CLI for PRs, issues, and checks",
            "mode": "subagent",
            "temperature": 0.1,
            "prompt": "{file:./prompts/github-specialist.md}",
            "permission": {
                "edit": "deny",
                "webfetch": "deny",
                "task": {
                    "*": "deny"
                },
                "bash": {
                    "*": "deny",
                    "gh *": "allow",
                    "git status *": "allow",
                    "git diff*": "allow",
                    "git log*": "allow"
                }
            }
        },
        "docs-researcher": {
            "description": "Documentation specialist for web and Context7 research",
            "mode": "subagent",
            "temperature": 0.1,
            "prompt": "{file:./prompts/docs-researcher.md}",
            "permission": {
                "edit": "deny",
                "bash": "deny",
                "webfetch": "allow",
                "task": {
                    "*": "deny"
                }
            }
        },
        "test-runner": {
            "description": "Testing specialist that runs and analyzes test, lint, and build checks",
            "mode": "subagent",
            "temperature": 0.1,
            "prompt": "{file:./prompts/test-runner.md}",
            "permission": {
                "edit": "deny",
                "bash": "allow",
                "task": {
                    "*": "deny"
                }
            }
        },
        "browser-agent": {
            "description": "Browser automation specialist that prioritizes Playwright MCP workflows",
            "mode": "all",
            "temperature": 0.1,
            "prompt": "{file:./prompts/browser-agent.md}",
            "permission": {
                "bash": {
                    "*": "allow"
                },
                "task": {
                    "*": "deny"
                }
            }
        }
    },

    "mcp": {
        "pdf-reader": {
            "type": "local",
            "command": ["bun", "x", "@sylphx/pdf-reader-mcp"],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": ["bun", "x", "@playwright/mcp@latest", "--browser", "firefox"],
            "enabled": true
        }
    }
}
